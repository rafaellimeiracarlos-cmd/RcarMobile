<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- Topo Estilo Mercado Livre -->
    <LinearLayout
        android:id="@+id/headerMercadoLivre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF5722"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/btnVoltarinicial"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/btnvoltar"
            app:tint="#333333" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/fundo_barra_busca"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@android:drawable/ic_menu_search"
                app:tint="#999999" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Buscar no RCar Premium..."
                android:textColor="#888888"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnCarrinhoTopo"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/carrinhocompras"
            app:tint="#333333" />
    </LinearLayout>

    <!-- Conteúdo Rolável -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/footerBotoesCompra"
        android:layout_below="@id/headerMercadoLivre">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Banner Promocional -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#120F0F"
                android:padding="8dp"
                android:text="⚡ OFERTA DO DIA | FRETE GRÁTIS ACIMA DE R$ 79"
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Imagem Principal do Produto -->
            <ImageView
                android:id="@+id/imgProdutoDetalhe"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/pecasautomotiva" />

            <!-- Card de Informações e Preço -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Novo  |  +1000 vendidos"
                    android:textColor="#888888"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txtNomeProdutoDetalhe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Kit Pastilha de Freio Dianteira RCar Premium Alta Performance"
                    android:textColor="#333333"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="R$ 189,90"
                    android:textColor="#888888"
                    android:textSize="14sp"
                    style="@style/Widget.AppCompat.TextView" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtPrecoProdutoDetalhe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="R$ 150,00"
                        android:textColor="#333333"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="20% OFF"
                        android:textColor="#F44336"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtParcelamento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="em 3x de R$ 50,00 sem juros"
                    android:textColor="#FF5722"
                    android:textSize="13sp" />

                <!-- Informação de Frete -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chegará grátis amanhã"
                        android:textColor="#FF5722"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Seletor de Quantidade -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="#F8F8F8"
                    android:gravity="center_vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Quantidade:"
                        android:textColor="#333333"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btnDiminuirQtd"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:backgroundTint="#E0E0E0"
                        android:padding="0dp"
                        android:text="-"
                        android:textColor="#333333" />

                    <TextView
                        android:id="@+id/txtQuantidadeDetalhe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:text="1"
                        android:textColor="#333333"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnAumentarQtd"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:backgroundTint="#E0E0E0"
                        android:padding="0dp"
                        android:text="+"
                        android:textColor="#333333" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card Descrição -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#FFFFFF"
                android:textColor="#FF5722"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Descrição"
                    android:textColor="#333333"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Jogo de pastilhas de freio dianteiras de alta durabilidade e frenagem precisa. Produto original RCar Premium com garantia de fábrica de 3 meses."
                    android:textColor="#666666"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Rodapé de Ações Fixas na Tela -->
    <LinearLayout
        android:id="@+id/footerBotoesCompra"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="12dp">

        <Button
            android:id="@+id/btnAdicionarAoCarrinho"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="#FFFFFF"
            android:textColor="#FF5722"
            android:text="Adicionar ao carrinho"
            android:textStyle="bold" />


        <Button
            android:id="@+id/btnComprarAgora"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="#FF5722"
            android:text="Comprar agora"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />


    </LinearLayout>

</RelativeLayout>